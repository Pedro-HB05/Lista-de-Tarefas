# ============================================
# Git Ignore - TaskFlow
# ============================================

# Banco de dados SQLite local
# (O banco é criado automaticamente ao iniciar a aplicação)
*.db
*.sqlite3
back/tasks.db

# Cache de compilação do Python
__pycache__/
*.py[cod]
*$py.class

# Ambientes virtuais
venv/
.venv/
env/
ENV/

# Arquivos de editores e IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Arquivos temporários do sistema operacional
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
